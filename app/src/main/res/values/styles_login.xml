<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 登录页面自定义样式 - 极简风格 -->
    
    <!-- 输入框样式：Outlined样式，极简线条 -->
    <style name="LoginInputStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxStrokeColor">@color/input_stroke_color_selector</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2.5dp</item>
        <item name="hintTextColor">@color/input_hint</item>
        <item name="android:textColorHint">@color/input_hint</item>
        <item name="startIconTint">@color/input_icon</item>
        <item name="endIconTint">@color/input_icon</item>
    </style>
    
    <!-- 输入框文字样式 -->
    <style name="LoginEditTextStyle" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">#212121</item>
        <item name="android:textColorHint">#999999</item>
        <item name="android:textSize">16sp</item>
    </style>
    
    <!-- Exposed Dropdown Menu 样式 -->
    <style name="LoginDropdownStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxStrokeColor">@color/input_stroke_color_selector</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2.5dp</item>
        <item name="hintTextColor">@color/input_hint</item>
        <item name="android:textColorHint">@color/input_hint</item>
        <item name="endIconTint">@color/dropdown_icon_color_selector</item>
    </style>
    
    <!-- Exposed Dropdown Menu 文字样式 -->
    <style name="LoginDropdownEditTextStyle" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">#212121</item>
        <item name="android:textColorHint">#999999</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
</resources>
