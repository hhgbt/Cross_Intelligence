<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- 顶部渐变背景 -->
        <View
            android:id="@+id/topBackground"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:background="@drawable/gradient_forest_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Welcome Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWelcome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_welcome_background"
                android:padding="24dp">

                <!-- 欢迎图标 -->
                <TextView
                    android:id="@+id/ivWelcomeIcon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/circle_background"
                    android:backgroundTint="@color/white"
                    android:contentDescription="欢迎"
                    android:gravity="center"
                    android:text="👨‍💼"
                    android:textSize="28sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- 欢迎标题 -->
                <TextView
                    android:id="@+id/tvWelcomeTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:text="管理员，你好！"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivWelcomeIcon"
                    app:layout_constraintTop_toTopOf="@id/ivWelcomeIcon" />

                <!-- 欢迎副标题 -->
                <TextView
                    android:id="@+id/tvWelcomeSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:text="Welcome to Cross Intelligence"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:textColor="#E0FFFFFF"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivWelcomeIcon"
                    app:layout_constraintTop_toBottomOf="@id/tvWelcomeTitle" />

                <!-- 统计数据区域 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvWelcomeSubtitle">

                    <!-- 赛事统计 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRaceCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5"
                            android:textAppearance="?attr/textAppearanceHeadline4"
                            android:textColor="@color/white"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="场赛事"
                            android:textAppearance="?attr/textAppearanceCaption"
                            android:textColor="#E0FFFFFF" />
                    </LinearLayout>

                    <!-- 竖线分隔 -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="40dp"
                        android:alpha="0.3"
                        android:background="@color/white" />

                    <!-- 打卡点统计 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCheckpointCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="128"
                            android:textAppearance="?attr/textAppearanceHeadline4"
                            android:textColor="@color/white"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="个打卡点"
                            android:textAppearance="?attr/textAppearanceCaption"
                            android:textColor="#E0FFFFFF" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 功能区域标题 -->
        <TextView
            android:id="@+id/tvFunctionsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="32dp"
            android:text="管理功能"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textColor="#2E7D32"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardWelcome" />

        <!-- 功能入口网格区域 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/gridFunctions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvFunctionsTitle">

            <!-- 第一行：创建赛事（占满整行） -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCreateRace"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/card_function_background"
                    android:padding="20dp">

                    <!-- 图标 -->
                    <TextView
                        android:id="@+id/ivCreateRace"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="@color/white"
                        android:gravity="center"
                        android:text="🏁"
                        android:textSize="32sp"
                        android:contentDescription="创建赛事"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/tvCreateRace"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <!-- 标题 -->
                    <TextView
                        android:id="@+id/tvCreateRace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="创建赛事"
                        android:textAppearance="?attr/textAppearanceBody1"
                        android:textColor="#2E7D32"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ivCreateRace"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 第二行：管理赛事 | 选手成绩 -->
            <!-- 管理赛事 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardViewRaces"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:layout_constraintEnd_toStartOf="@id/cardPlayerRanking"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardCreateRace">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/card_function_background"
                    android:padding="16dp">

                    <!-- 图标 -->
                    <TextView
                        android:id="@+id/ivViewRaces"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="@color/white"
                        android:gravity="center"
                        android:text="📋"
                        android:textSize="28sp"
                        android:contentDescription="管理赛事"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/tvViewRaces"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <!-- 标题 -->
                    <TextView
                        android:id="@+id/tvViewRaces"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="管理赛事"
                        android:textAppearance="?attr/textAppearanceBody1"
                        android:textColor="#2E7D32"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ivViewRaces"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 选手成绩 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPlayerRanking"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/cardViewRaces"
                app:layout_constraintTop_toBottomOf="@id/cardCreateRace">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/card_function_background"
                    android:padding="16dp">

                    <!-- 图标 -->
                    <TextView
                        android:id="@+id/ivPlayerRanking"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="@color/white"
                        android:gravity="center"
                        android:text="🏆"
                        android:textSize="28sp"
                        android:contentDescription="选手成绩"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/tvPlayerRanking"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <!-- 标题 -->
                    <TextView
                        android:id="@+id/tvPlayerRanking"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="选手成绩"
                        android:textAppearance="?attr/textAppearanceBody1"
                        android:textColor="#2E7D32"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ivPlayerRanking"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
