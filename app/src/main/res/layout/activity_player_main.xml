<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- 顶部渐变背景 -->
        <View
            android:id="@+id/topBackground"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:background="@drawable/gradient_forest_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Welcome Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWelcome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_welcome_background"
                android:padding="24dp">

                <!-- 欢迎图标 -->
                <TextView
                    android:id="@+id/ivWelcomeIcon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/circle_background"
                    android:backgroundTint="@color/white"
                    android:gravity="center"
                    android:text="🏃"
                    android:textSize="28sp"
                    android:contentDescription="欢迎"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- 欢迎标题 -->
                <TextView
                    android:id="@+id/tvWelcomeTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="选手，你好！"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivWelcomeIcon"
                    app:layout_constraintTop_toTopOf="@id/ivWelcomeIcon" />

                <!-- 欢迎副标题 -->
                <TextView
                    android:id="@+id/tvWelcomeSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:text="Ready to Race"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:textColor="#E0FFFFFF"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivWelcomeIcon"
                    app:layout_constraintTop_toBottomOf="@id/tvWelcomeTitle" />

                <!-- 分隔线 -->
                <View
                    android:id="@+id/divider"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:alpha="0.3"
                    android:background="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivWelcomeIcon" />

                <!-- 统计数据区域 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider">

                    <!-- 已报名赛事统计 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRegisteredRaceCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textAppearance="?attr/textAppearanceHeadline4"
                            android:textColor="@color/white"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="已报名赛事"
                            android:textAppearance="?attr/textAppearanceCaption"
                            android:textColor="#E0FFFFFF" />
                    </LinearLayout>

                    <!-- 竖线分隔 -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="40dp"
                        android:alpha="0.3"
                        android:background="@color/white" />

                    <!-- 已完成赛事统计 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvFinishedRaceCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textAppearance="?attr/textAppearanceHeadline4"
                            android:textColor="@color/white"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="已完成赛事"
                            android:textAppearance="?attr/textAppearanceCaption"
                            android:textColor="#E0FFFFFF" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 功能区域标题 -->
        <TextView
            android:id="@+id/tvFunctionsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="32dp"
            android:text="选手功能"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textColor="@color/forest_green"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardWelcome" />

        <!-- 功能入口网格区域 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/gridFunctions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvFunctionsTitle">

            <!-- 第一行：报名赛事（占满整行） -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRegisterRace"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/card_function_background"
                    android:padding="20dp">

                    <!-- 图标 -->
                    <TextView
                        android:id="@+id/ivRegisterRace"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="@color/white"
                        android:gravity="center"
                        android:text="📝"
                        android:textSize="32sp"
                        android:contentDescription="报名赛事"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/tvRegisterRace"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <!-- 标题 -->
                    <TextView
                        android:id="@+id/tvRegisterRace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="报名赛事"
                        android:textAppearance="?attr/textAppearanceBody1"
                        android:textColor="@color/forest_green"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ivRegisterRace"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 第二行：我的赛事 | 我的成绩 -->
            <!-- 我的赛事 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMyRaces"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:layout_constraintEnd_toStartOf="@id/cardMyResults"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardRegisterRace">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/card_function_background"
                    android:padding="16dp">

                    <!-- 图标 -->
                    <TextView
                        android:id="@+id/ivMyRaces"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="@color/white"
                        android:gravity="center"
                        android:text="🗺️"
                        android:textSize="28sp"
                        android:contentDescription="我的赛事"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/tvMyRaces"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <!-- 标题 -->
                    <TextView
                        android:id="@+id/tvMyRaces"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="我的赛事"
                        android:textAppearance="?attr/textAppearanceBody1"
                        android:textColor="@color/forest_green"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ivMyRaces"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 我的成绩 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMyResults"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/cardMyRaces"
                app:layout_constraintTop_toBottomOf="@id/cardRegisterRace">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/card_function_background"
                    android:padding="16dp">

                    <!-- 图标 -->
                    <TextView
                        android:id="@+id/ivMyResults"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="@color/white"
                        android:gravity="center"
                        android:text="🏆"
                        android:textSize="28sp"
                        android:contentDescription="我的成绩"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/tvMyResults"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <!-- 标题 -->
                    <TextView
                        android:id="@+id/tvMyResults"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="我的成绩"
                        android:textAppearance="?attr/textAppearanceBody1"
                        android:textColor="@color/forest_green"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ivMyResults"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
