<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_qr_dialog_glass"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- 打卡点名称 -->
        <TextView
            android:id="@+id/tvCheckPointName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="打卡点名称"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="20dp" />

        <!-- 距离信息（带图标） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="28dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_location"
                android:layout_marginEnd="6dp"
                app:tint="#4CAF50" />

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="距离：0米"
                android:textSize="14sp"
                android:textColor="#666666" />
        </LinearLayout>

        <!-- 二维码容器（带发光效果和扫描动画） -->
        <FrameLayout
            android:id="@+id/qrContainer"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_qr_code_glow"
            android:elevation="8dp"
            android:padding="16dp">

            <!-- 二维码图片 -->
            <ImageView
                android:id="@+id/ivQrCode"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="打卡点二维码"
                android:scaleType="fitCenter"
                android:background="#FFFFFF" />

            <!-- 扫描线（动画） -->
            <View
                android:id="@+id/scanLine"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@drawable/qr_scan_line"
                android:visibility="visible" />

        </FrameLayout>

        <!-- 状态提示（柔和样式） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="长按二维码即可扫描打卡"
            android:textSize="18sp"
            android:textColor="#2196F3"
            android:textStyle="bold"
            android:background="@drawable/bg_hint_text_blue"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="或使用其他设备扫描此二维码"
            android:textSize="14sp"
            android:textColor="#999999"
            android:layout_marginBottom="20dp" />

        <!-- 备用方案链接 -->
        <TextView
            android:id="@+id/tvCameraScan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="扫描失败？点这里"
            android:textColor="#FF9800"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:background="?attr/selectableItemBackground"
            android:layout_marginBottom="24dp" />

        <!-- 关闭按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="120dp"
            android:minHeight="56dp"
            android:text="关闭"
            android:textSize="16sp"
            app:cornerRadius="20dp"
            android:backgroundTint="@color/forest_green"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</FrameLayout>



